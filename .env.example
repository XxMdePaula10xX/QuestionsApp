# Firebase Web SDK — copie para `.env.local` e preencha com os valores do seu projeto.
# (Console Firebase > Configurações do projeto > Seus apps > Config do SDK)
# Estes valores são PÚBLICOS por natureza (vão para o bundle do cliente); a segurança
# real vem das Security Rules + App Check, não de esconder a config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase App Check (reCAPTCHA v3 site key p/ web). Ver blocker B1 do PRD-REVIEW.
VITE_RECAPTCHA_V3_SITE_KEY=

# FCM Web Push (VAPID key par "Web Push certificates" no console). Opcional.
VITE_FIREBASE_VAPID_KEY=

# Emuladores locais (true para usar Firebase Emulator Suite em dev)
VITE_USE_FIREBASE_EMULATORS=false
