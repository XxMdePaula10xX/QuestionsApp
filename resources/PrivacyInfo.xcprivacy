<?xml version="1.0" encoding="UTF-8"?>
<!--
  Privacy Manifest do Sabido (exigido pela Apple).
  O workflow iOS do Codemagic copia este arquivo para ios/App/App/PrivacyInfo.xcprivacy.
  Revise com apoio jurídico e mantenha coerente com PRIVACY.md e o App Privacy do App Store Connect.
-->
