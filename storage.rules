rules_version = '2';

// Storage — perguntas servidas APENAS a usuários autenticados (revisão: não
// deixar o JSON público). Escrita só por admin (deploy do pipeline de conteúdo).
// TODO(Sprint 2): exigir App Check: `&& request.app != null`.
service firebase.storage {
  match /b/{bucket}/o {
    match /questions/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Avatares enviados pelo usuário (futuro).
    match /avatars/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
